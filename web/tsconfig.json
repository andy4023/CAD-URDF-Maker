{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "node",
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "removeComments": false
  },
  "include": ["*.ts"]
}
